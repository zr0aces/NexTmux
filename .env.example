# TermHub environment variable example

# Dashboard port (default: 8081)
PORT=8081

# Dashboard password (change before deploying)
DASHBOARD_PASSWORD=changeme

# Session lifetime in milliseconds (default: 7 days)
SESSION_TTL_MS=604800000

# Trust X-Forwarded-For for client IPs (set to 1 only behind a trusted reverse proxy)
TRUST_PROXY=0

# Discord notification webhook (optional)
DISCORD_WEBHOOK=

# Discord alert webhook (optional; falls back to DISCORD_WEBHOOK if unset)
DISCORD_ALERT_WEBHOOK=

# Enable tunnel health check (1 = check every 60 s)
ENABLE_TUNNEL_HEALTHCHECK=0

# ── Preview tab feature ────────────────────────────────
# Auto-create a preview tab when localhost:XXXX is detected in terminal output
ENABLE_PREVIEW=1

# Auto-create a cloudflared tunnel for detected ports (for remote access)
# cloudflared must be installed and available in PATH.
# Download: https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads/
PREVIEW_TUNNEL=0

# Enable/disable the cloudflared dashboard tunnel (default: 1 = enabled)
# Set to 0 to skip cloudflared entirely.
# Can also be disabled via config.json → "tunnel": { "enabled": false }
ENABLE_TUNNEL=1

# ── AI Session Monitor (MVP) ─────────────────────────
# Set 1 to enable wait-state supervision engine
AI_MONITOR_ENABLED=1

# Polling interval for tmux pane capture (ms)
AI_MONITOR_POLL_INTERVAL_MS=1000

# No output change duration before idle transition (ms)
AI_MONITOR_IDLE_THRESHOLD_MS=5000

# Recent lines inspected for wait-state patterns
AI_MONITOR_LINES_TO_SCAN=120

# Debounce cooldown for duplicate wait notifications (ms)
AI_MONITOR_NOTIFY_COOLDOWN_MS=120000

# Telegram outbound notification settings (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
